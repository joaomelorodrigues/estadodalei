# MongoDB da stack Docker (docker compose up -d mongo; o pnpm dev arranca-o sozinho).
# É também o endereço para o MongoDB Compass.
MONGODB_URI=mongodb://127.0.0.1:27018/estadodalei

# API
PORT=4000

# Legislatura: auto = deteta a mais recente publicada pela AR (muda sozinha depois de eleições).
# Para fixar uma, usar a numeração romana da AR (ex.: XVII).
LEGISLATURE=auto

# Agendamento da sincronização (cron). Vazio = desligado.
SYNC_CRON=15 */3 * * *
# Ao arrancar, sincroniza logo se os dados tiverem mais de 3 h (recupera períodos com o servidor desligado)
SYNC_ON_START=true
# Tempo máximo de uma sincronização (minutos) antes de ser dada como falhada
SYNC_TIMEOUT_MIN=30

# Alertas: URL de heartbeat (ex.: https://hc-ping.com/<uuid> do healthchecks.io, gratuito).
# Chamado depois de cada sincronização; se os dados ficarem desatualizados chama <URL>/fail,
# e se o servidor parar os pings deixam de chegar. Em ambos os casos o serviço envia um email.
HEARTBEAT_URL=

# Token para POST /api/admin/sync (Authorization: Bearer <token>)
ADMIN_TOKEN=

# User-Agent enviado às fontes de dados
SYNC_USER_AGENT=Mozilla/5.0 (compatible; civic-open-data-sync/1.0)

# Fonte do Parlamento: auto (AR oficial, com reserva no open-data.pt) | ar | opendata
SYNC_PROVIDER=auto
