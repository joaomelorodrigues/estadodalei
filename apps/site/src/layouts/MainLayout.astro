---
import "@/styles/global.css";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  /** Sem o intervalo entre o conteúdo e o rodapé. */
  tightFooter?: boolean;
}

const {
  title = "estadodalei.pt — As leis de Portugal explicadas para todos",
  description = "Acompanha as propostas de lei da Assembleia da República traduzidas para português simples. Descobre o resumo diário, as consequências práticas e quem é afetado por cada lei.",
  currentPath = Astro.url.pathname,
  tightFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Friendly Modern Civic Typography: Red Hat Display + Figtree + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Red+Hat+Display:wght@600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground selection:bg-primary/15 selection:text-primary">
    <Navbar currentPath={currentPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer class={tightFooter ? "mt-0" : undefined} />
  </body>
</html>
