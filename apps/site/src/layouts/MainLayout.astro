---
// Fontes servidas pelo próprio site (sem pedidos ao Google): Figtree no texto,
// Red Hat Display nos títulos e JetBrains Mono nalguns números.
import "@fontsource-variable/figtree/wght.css";
import "@fontsource-variable/red-hat-display/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import figtreeLatin from "@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url";
import redHatLatin from "@fontsource-variable/red-hat-display/files/red-hat-display-latin-wght-normal.woff2?url";
import "@/styles/global.css";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import Analytics from "@/components/Analytics.astro";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  /** Sem o intervalo entre o conteúdo e o rodapé. */
  tightFooter?: boolean;
}

const {
  title = "estadodalei.pt — As leis de Portugal explicadas para todos",
  description = "Acompanha as propostas de lei da Assembleia da República traduzidas para português simples. Descobre o resumo diário, as consequências práticas e quem é afetado por cada lei.",
  currentPath = Astro.url.pathname,
  tightFooter = false,
} = Astro.props;

// Endereço canónico e pré-visualização dos links partilhados (Open Graph, X).
// No domínio do site usa sempre https://estadodalei.pt; noutros endereços (testes
// locais, IP do NAS) usa o do próprio pedido, para o canónico apontar para a mesma página.
const site = Astro.site ?? new URL("https://estadodalei.pt");
const onSite = Astro.url.hostname === site.hostname || Astro.url.hostname === `www.${site.hostname}`;
const origin = onSite ? site.origin : Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL("/og-image.jpg", origin).href;
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="estadodalei.pt" />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="estadodalei.pt: as leis de Portugal explicadas para todos" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- As duas fontes do primeiro ecrã (alfabeto latino) chegam logo com a página: sem troca de letra a meio. -->
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={redHatLatin} as="font" type="font/woff2" crossorigin />
    <Analytics />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground selection:bg-primary/15 selection:text-primary">
    <Navbar currentPath={currentPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer class={tightFooter ? "mt-0" : undefined} />
  </body>
</html>
