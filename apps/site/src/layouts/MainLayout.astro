---
// Fontes servidas pelo próprio site (sem pedidos ao Google): Figtree no texto,
// Red Hat Display nos títulos e JetBrains Mono nalguns números.
import "@fontsource-variable/figtree/wght.css";
import "@fontsource-variable/red-hat-display/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import figtreeLatin from "@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url";
import redHatLatin from "@fontsource-variable/red-hat-display/files/red-hat-display-latin-wght-normal.woff2?url";
import "@/styles/global.css";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import Analytics from "@/components/Analytics.astro";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  /** Sem o intervalo entre o conteúdo e o rodapé. */
  tightFooter?: boolean;
}

const {
  title = "estadodalei.pt — As leis de Portugal explicadas para todos",
  description = "Acompanha as propostas de lei da Assembleia da República traduzidas para português simples. Descobre o resumo diário, as consequências práticas e quem é afetado por cada lei.",
  currentPath = Astro.url.pathname,
  tightFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- As duas fontes do primeiro ecrã (alfabeto latino) chegam logo com a página: sem troca de letra a meio. -->
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={redHatLatin} as="font" type="font/woff2" crossorigin />
    <Analytics />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground selection:bg-primary/15 selection:text-primary">
    <Navbar currentPath={currentPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer class={tightFooter ? "mt-0" : undefined} />
  </body>
</html>
