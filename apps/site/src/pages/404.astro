---
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout title="Página não encontrada — estadodalei.pt">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-sm font-bold text-primary">404</p>
    <h1 class="mt-2 font-editorial text-3xl font-extrabold text-foreground">Esta página não existe</h1>
    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
      A iniciativa ou página que procuras não foi encontrada. Pode ter sido escrita de forma diferente.
    </p>
    <a href="/" class="mt-6 inline-flex rounded-full bg-foreground px-5 py-2.5 text-xs font-bold text-white hover:bg-primary">
      Voltar ao início
    </a>
  </section>
</MainLayout>
