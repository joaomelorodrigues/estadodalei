---
import type { CompositionDTO, HighlightsDTO, PartyRecordDTO } from "@estadodalei/shared";
import MainLayout from "@/layouts/MainLayout.astro";
import ApiUnavailable from "@/components/ApiUnavailable.astro";
import { ParliamentHero } from "@/components/ParliamentHero";
import { PartyRecord } from "@/components/PartyRecord";
import { api } from "@/lib/api";
import { toProposal } from "@/lib/adapt";

let data: Awaited<ReturnType<typeof load>> | null = null;

// Balanço por partido (secção abaixo do hero). Se falhar, a secção não aparece.
const partyRecordPromise = api<PartyRecordDTO>("/party-record").catch((err) => {
  console.error("[home] balanço por partido indisponível:", err);
  return null;
});

async function load() {
  const [highlights, composition] = await Promise.all([
    api<HighlightsDTO>("/highlights?limit=8"),
    api<CompositionDTO>("/composition"),
  ]);
  const toList = (list: HighlightsDTO["pending"]) => list.map((h) => toProposal(h.initiative, h.keyVote));
  return {
    highlights,
    composition,
    pending: toList(highlights.pending),
    approved: toList(highlights.approved),
    rejected: toList(highlights.rejected),
  };
}

try {
  data = await load();
} catch (err) {
  console.error("[home] API indisponível:", err);
  Astro.response.status = 503;
}
const partyRecord = await partyRecordPromise;
Astro.response.headers.set("Cache-Control", "public, max-age=60");
---

<MainLayout
  title="estadodalei.pt — As leis de Portugal explicadas para todos"
  currentPath="/"
  tightFooter
>
  {
    data ? (
      <ParliamentHero
        client:load
        pending={data.pending}
        approved={data.approved}
        rejected={data.rejected}
        counts={data.highlights.counts}
        composition={data.composition.seats}
        totalSeats={data.composition.total || 230}
      />
    ) : (
      <ApiUnavailable />
    )
  }
  {data && partyRecord ? <PartyRecord client:visible record={partyRecord} /> : null}
</MainLayout>
