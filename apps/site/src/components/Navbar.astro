---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

// Ícones (traços do Lucide) usados no menu móvel.
const icons = {
  home: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  user: '<circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>',
};

const navLinks = [
  { href: "/", label: "Início", icon: icons.home, match: (p: string) => p === "/" },
  { href: "/para-mim", label: "O que me afeta", icon: icons.user, match: (p: string) => p.startsWith("/para-mim") },
];
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex min-w-0 shrink items-center focus:outline-none">
      <span class="font-editorial truncate text-lg font-extrabold tracking-tight text-foreground sm:text-xl">
        estadodalei<span class="text-primary">.pt</span>
      </span>
    </a>

    <nav aria-label="Navegação principal" class="hidden h-full items-center gap-7 lg:flex">
      {navLinks.map((item) => {
        const active = item.match(currentPath);
        return (
          <a
            href={item.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "relative flex h-full items-center whitespace-nowrap text-sm transition-colors",
              active
                ? "font-bold text-primary after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[3px] after:rounded-t-full after:bg-primary"
                : "font-semibold text-foreground/75 hover:text-primary",
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden shrink-0 items-center lg:flex">
      <a
        href="/para-mim"
        class="inline-flex items-center whitespace-nowrap rounded-full bg-primary px-4 py-2 text-xs font-bold text-white shadow-[0_4px_12px_-2px_rgba(19,91,255,0.4)] transition-colors hover:bg-[#0D49DB]"
      >
        Afeta-me a mim?
      </a>
    </div>

    <button
      id="menu-button"
      type="button"
      class="inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:bg-secondary active:bg-secondary lg:hidden"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menu"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>
</header>

<!--
  Menu móvel: gaveta lateral num <dialog> modal. O browser trata do foco
  (fica preso dentro do menu e volta ao botão ao fechar), da tecla Esc e de
  tornar o resto da página inacessível enquanto está aberto.
-->
<dialog id="mobile-menu" class="mobile-drawer" aria-label="Menu">
  <div class="flex h-full flex-col">
    <div class="flex h-16 shrink-0 items-center justify-between gap-3 border-b border-border pl-5 pr-3">
      <a href="/" class="min-w-0 focus:outline-none">
        <span class="font-editorial truncate text-lg font-extrabold tracking-tight text-foreground">
          estadodalei<span class="text-primary">.pt</span>
        </span>
      </a>
      <button
        type="button"
        data-menu-close
        autofocus
        class="inline-flex size-11 shrink-0 items-center justify-center rounded-full text-foreground transition-colors hover:bg-secondary active:bg-secondary"
        aria-label="Fechar menu"
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <nav aria-label="Navegação móvel" class="flex-1 overflow-y-auto overscroll-contain px-3 py-3">
      <ul class="flex flex-col gap-1">
        {navLinks.map((item) => {
          const active = item.match(currentPath);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "flex min-h-14 items-center gap-3.5 rounded-2xl px-3 text-base transition-colors",
                  active
                    ? "bg-secondary font-bold text-primary"
                    : "font-semibold text-foreground/85 hover:bg-secondary/70 active:bg-secondary",
                ]}
              >
                <span
                  class:list={[
                    "inline-flex size-9 shrink-0 items-center justify-center rounded-xl",
                    active ? "bg-primary text-white" : "bg-secondary text-primary",
                  ]}
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="size-[18px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={item.icon}
                  />
                </span>
                <span class="flex-1">{item.label}</span>
                <svg viewBox="0 0 24 24" class="size-4 shrink-0 opacity-40" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex shrink-0 flex-col gap-2 border-t border-border p-4">
      <a
        href="/para-mim"
        class="inline-flex h-12 items-center justify-center rounded-full bg-primary text-sm font-bold text-white shadow-[0_4px_12px_-2px_rgba(19,91,255,0.4)] transition-colors active:bg-[#0D49DB]"
      >
        Afeta-me a mim?
      </a>
    </div>
  </div>
</dialog>

<style is:global>
  .mobile-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(22rem, 88vw);
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 1.25rem 0 0 1.25rem;
    background: #fff;
    color: var(--foreground);
    box-shadow: -18px 0 40px rgba(10, 29, 86, 0.18);
    overflow: hidden;

    translate: 100% 0;
    transition:
      translate 320ms cubic-bezier(0.32, 0.72, 0, 1),
      overlay 320ms allow-discrete,
      display 320ms allow-discrete;
  }

  .mobile-drawer[open] {
    translate: 0 0;
  }

  .mobile-drawer::backdrop {
    background-color: rgb(10 29 86 / 0);
    transition:
      background-color 320ms ease,
      overlay 320ms allow-discrete,
      display 320ms allow-discrete;
  }

  .mobile-drawer[open]::backdrop {
    background-color: rgb(10 29 86 / 0.45);
  }

  @starting-style {
    .mobile-drawer[open] {
      translate: 100% 0;
    }
    .mobile-drawer[open]::backdrop {
      background-color: rgb(10 29 86 / 0);
    }
  }

  /* A página por trás não faz scroll enquanto o menu está aberto. */
  html:has(.mobile-drawer[open]) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-drawer,
    .mobile-drawer::backdrop {
      transition: none;
    }
  }
</style>

<script>
  const button = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-menu");

  if (button && menu instanceof HTMLDialogElement) {
    const close = () => {
      if (menu.open) menu.close();
    };

    button.addEventListener("click", () => {
      menu.showModal();
      button.setAttribute("aria-expanded", "true");
    });

    menu.addEventListener("close", () => {
      button.setAttribute("aria-expanded", "false");
    });

    menu.querySelector("[data-menu-close]")?.addEventListener("click", close);

    // Toque no fundo escurecido (fora da gaveta) fecha o menu.
    menu.addEventListener("click", (event) => {
      const rect = menu.getBoundingClientRect();
      const inside =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom;
      if (!inside) close();
    });

    // Ao escolher um destino, a gaveta fecha enquanto a página seguinte carrega.
    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));

    // Voltar atrás no browser pode restaurar a página tal como estava; o menu volta fechado.
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) close();
    });

    window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
      if (event.matches) close();
    });
  }
</script>
