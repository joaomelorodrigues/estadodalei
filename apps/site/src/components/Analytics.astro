---
/**
 * Estatísticas de visitas com a PostHog, sem cookies nem armazenamento no browser
 * (cookieless_mode: o visitante é identificado por um hash calculado nos servidores
 * da PostHog). Por isso o site não precisa de aviso de cookies.
 *
 * Só liga com POSTHOG_KEY definido no servidor (variável de ambiente, lida em cada
 * pedido): em desenvolvimento e em cópias do código não é enviado nada.
 * No projeto da PostHog, o modo sem cookies tem de estar ativo nas definições,
 * senão as visitas são ignoradas.
 */
const key = process.env.POSTHOG_KEY?.trim();
const host = process.env.POSTHOG_HOST?.trim() || "https://eu.i.posthog.com";
---

{key && <meta name="posthog" data-key={key} data-host={host} />}

<script>
  const meta = document.querySelector<HTMLMetaElement>('meta[name="posthog"]');
  const key = meta?.dataset.key;
  // A posthog-js (~130 KB) e o arranque dela (configuração remota, autocaptura) ficam
  // para o fim: depois do load, da primeira pintura com conteúdo tal como o browser a
  // regista (o momento em que aparece no ecrã, que pode vir depois dos frames do
  // requestAnimationFrame) e de START_DELAY_MS com o browser livre. Assim não compete
  // com o LCP nem junta trabalho às tarefas da hidratação e do hemiciclo 3D (TBT).
  // Custo: visitas de menos de ~2 s não são contadas.
  const START_DELAY_MS = 2000;
  const whenIdle = (fn: () => void) =>
    "requestIdleCallback" in window ? requestIdleCallback(fn, { timeout: 3000 }) : setTimeout(fn, 1);
  const afterLoad = (fn: () => void) =>
    document.readyState === "complete" ? fn() : addEventListener("load", fn, { once: true });
  const afterFirstPaint = (fn: () => void) => {
    const fcp = () => performance.getEntriesByName("first-contentful-paint").length > 0;
    if (!PerformanceObserver.supportedEntryTypes?.includes("paint") || fcp()) return fn();
    const observer = new PerformanceObserver(() => {
      if (!fcp()) return;
      observer.disconnect();
      fn();
    });
    observer.observe({ type: "paint", buffered: true });
  };
  if (key) afterLoad(() => afterFirstPaint(() => setTimeout(() => whenIdle(() => {
    import("posthog-js").then(({ default: posthog }) => {
      posthog.init(key, {
        api_host: meta.dataset.host,
        defaults: "2026-08-30",
        cookieless_mode: "always",
        // Só visitas e cliques: nada de gravação de sessões, inquéritos nem scripts externos.
        disable_session_recording: true,
        disable_surveys: true,
        disable_external_dependency_loading: true,
      });
    });
  }), START_DELAY_MS)));
</script>
